/* style.css */
::-webkit-scrollbar { 
    width: 6px; 
    height: 6px; 
}
::-webkit-scrollbar-track { 
    background: transparent; 
}
::-webkit-scrollbar-thumb { 
    background: #cbd5e1; 
    border-radius: 10px; 
}
::-webkit-scrollbar-thumb:hover { 
    background: #94a3b8; 
}
body { 
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); 
    min-height: 100vh; 
}
